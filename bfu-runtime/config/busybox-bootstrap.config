# Minimal Android/Bionic toolbox used only to install and manage DawnShell's
# Debian rootfs.  Feed this fragment to BusyBox with KCONFIG_ALLCONFIG and
# `make allnoconfig`, then merge each enabled symbol before `oldconfig`; do not
# replace it with a host-generated .config.

CONFIG_DESKTOP=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LFS=y
CONFIG_PIE=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_FEATURE_VERSION=y
CONFIG_FEATURE_PATH_TRAVERSAL_PROTECTION=y

# Archive and Debian package extraction.
CONFIG_AR=y
CONFIG_DPKG_DEB=y
CONFIG_GUNZIP=y
CONFIG_GZIP=y
CONFIG_ZCAT=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
CONFIG_TAR=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_PRESERVE_HARDLINKS=y

# Core file, text, checksum, and process utilities used by debootstrap and the
# app's root-only management scripts.
CONFIG_BASENAME=y
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHROOT=y
CONFIG_CKSUM=y
CONFIG_CMP=y
CONFIG_CP=y
CONFIG_FEATURE_CP_LONG_OPTIONS=y
CONFIG_CUT=y
CONFIG_DATE=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_DIRNAME=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_EXPR=y
CONFIG_FALSE=y
CONFIG_HEAD=y
CONFIG_ID=y
CONFIG_INSTALL=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y
CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y
CONFIG_MKDIR=y
CONFIG_MKFIFO=y
CONFIG_MKNOD=y
CONFIG_MKTEMP=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_SYNC=y
CONFIG_TAIL=y
CONFIG_TEE=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_TRUE=y
CONFIG_TRUNCATE=y
CONFIG_UNAME=y
CONFIG_UNIQ=y
CONFIG_WC=y
CONFIG_WHICH=y

# Text processing and traversal.
CONFIG_AWK=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_DEPTH=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_EXEC_PLUS=y
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_XARGS=y
CONFIG_FEATURE_XARGS_SUPPORT_ZERO_TERM=y

# Namespace and mount lifecycle.  These applets execute only under a
# pre-authorized Magisk root shell.
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FAKE=y
CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_UNSHARE=y

# Debian archive transport.  The mirror uses HTTP because BusyBox's internal
# TLS mode does not authenticate peers.  Authenticity is provided by bundled
# gpgv plus Debian Release and Packages hashes.
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y

# Portable upstream debootstrap runner.
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
